# Exemplo Gmail/Google Workspace via SMTP autenticado.
# Para Gmail, use uma senha de app. Não use a senha normal da conta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app
SMTP_FROM_EMAIL=seu-email@gmail.com
SMTP_FROM_NAME=Carlos Henrique Caldeira
SMTP_REPLY_TO=seu-email@gmail.com

# Conservador por padrão para preservar reputação da conta.
DAILY_LIMIT=25
SEND_INTERVAL_SECONDS=120
